{
  "expo": {
    "name": "Ubar",
    "slug": "ubar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },

    "plugins": [
      "expo-font",
      "expo-location",
      [
        "expo-maps",
        {
          "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      ]
    ]
  }
}
